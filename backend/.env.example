# ===========================================================================
# 问数星途 · 环境变量模板
# 用法：复制成 .env 再改值    cp .env.example .env
# .env 不要提交到 Git（已在 .gitignore 里排除），里面会有密钥。
# ===========================================================================

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# 登录令牌签名密钥：上线前**必须**换成随机长字符串，否则别人可以伪造登录态
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：生产环境下密钥必须 >= 32 位，否则服务会直接拒绝启动（这是我们故意加的护栏）。
# 也不要留空 —— 留空同样拒绝启动，避免用代码里的默认密钥裸奔。
JWT_SECRET=

# 跨域白名单（逗号分隔）。留空 = 允许所有来源，只适合本地联调；
# 上线后填真实域名，例如：CORS_ORIGIN=https://math.example.com
# CORS_ORIGIN=
# 登录态有效期（毫秒），默认 7 天
# TOKEN_TTL_MS=604800000

# ---------------------------------------------------------------------------
# AI 智能体（OpenAI 兼容协议，当前接 DeepSeek）
# 不填 LLM_API_KEY 会自动降级成内置规则引擎，功能不受影响（离线演示可用）
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.6
LLM_MAX_ROUNDS=3
# LLM_TIMEOUT=20000

# rules = 强制离线规则引擎；留空 = 有 Key 走大模型，没 Key 自动降级
# AGENT_PROVIDER=rules

# 免费版每天可问小问多少次（默认 10）
# AGENT_FREE_DAILY=10

# ---------------------------------------------------------------------------
# 数据库 / 缓存（一期是内存驱动，填了也不会自动切换，属预留）
# ---------------------------------------------------------------------------
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=wenshu
# DB_USER=root
# DB_PASSWORD=
# DB_POOL=10
# CACHE_DRIVER=redis
# CACHE_TTL=300
# REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# 反向代理 / 部署
# 上线走 Nginx 时后端已自动开启 trust proxy（见 src/app.js），
# 但 Nginx 那边要记得带上这两个头，否则限流拿不到真实客户端 IP：
#   proxy_set_header Host              $host;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 接口限流（次数 / 窗口秒数）
# ---------------------------------------------------------------------------
# RL_AGENT_CHAT=60
# RL_AGENT_REPORT=30
# RL_SEND_CODE=5